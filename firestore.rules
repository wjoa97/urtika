rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Private reactions subcollection per user
      match /reactions/{reactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reactionId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(reactionId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(reactionId);
      }
    }
  }
}
